# Full GPU worker image - SAM 3D Body, detector, Blender, all heavy deps.
# Build: docker build -f Dockerfile.worker -t fbxify-worker .
# Run: docker run --gpus all --shm-size=8g -p 8000:8000 fbxify-worker

FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive

# ---- System deps ----
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3.12-dev python3.12-venv python3-pip \
    curl \
    git \
    ffmpeg \
    build-essential \
    cmake \
    wget \
    libgl1 \
    libegl1 \
    libglib2.0-0 \
    libsm6 libxext6 libxrender1 \
    libosmesa6 libosmesa6-dev \
    && rm -rf /var/lib/apt/lists/*

# ---- Blender installation ----
RUN cd /opt && \
    wget https://download.blender.org/release/Blender5.0/blender-5.0.0-linux-x64.tar.xz && \
    tar -xvf blender-5.0.0-linux-x64.tar.xz && \
    mv blender-5.0.0-linux-x64 blender && \
    rm -f /usr/local/bin/blender && \
    ln -s /opt/blender/blender /usr/local/bin/blender && \
    rm -f blender-5.0.0-linux-x64.tar.xz

# ---- Blender Python setup ----
RUN /opt/blender/5.0/python/bin/python3.11 -m ensurepip && \
    /opt/blender/5.0/python/bin/python3.11 -m pip install --upgrade pip && \
    /opt/blender/5.0/python/bin/python3.11 -m pip install mediapipe

# ---- Python venv ----
RUN python3.12 -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

# ---- Core Python tooling (setuptools pinned: detectron2/ViTDet need pkg_resources) ----
RUN python -m pip install --upgrade pip wheel && \
    python -m pip install "setuptools<81"

# ---- NumPy + modern cu128 PyTorch ----
RUN python -m pip install "numpy<2"
RUN python -m pip install --index-url https://download.pytorch.org/whl/cu128 \
    torch==2.8.0 torchvision==0.23.0 torchaudio==2.8.0

# ---- Clone repo or copy from local ----
# PULL_FROM_LOCAL=1: use build context. PULL_FROM_LOCAL=0: git clone (BRANCH from config).
# Pass --build-arg CACHEBUST=$(git rev-parse HEAD) to force fresh clone (bypass cache)
ARG PULL_FROM_LOCAL=0
ARG BRANCH=main
ARG CACHEBUST
WORKDIR /fbxify
COPY . .
RUN if [ "${PULL_FROM_LOCAL}" != "1" ]; then \
      cd / && rm -rf /fbxify && git clone -b ${BRANCH} https://github.com/segfaultExpress/sam-3d-body-fbxify.git /fbxify; \
    fi

# ---- SAM-3D-Body Python deps ----
RUN python -m pip install \
      pytorch-lightning \
      roma \
      pyrender \
      opencv-python \
      pymomentum-gpu==0.1.94.post0 \
      yacs \
      scikit-image \
      einops \
      timm \
      dill \
      pandas \
      mhr \
      rich \
      hydra-core \
      hydra-submitit-launcher \
      hydra-colorlog \
      pyrootutils \
      webdataset \
      chump \
      "networkx==3.2.1" \
      joblib \
      seaborn \
      wandb \
      appdirs \
      ffmpeg-python \
      cython \
      jsonlines \
      pytest \
      loguru \
      optree \
      fvcore \
      black \
      pycocotools \
      tensorboard \
      huggingface_hub \
      pyopengl \
      pyopengl-accelerate \
      git+https://github.com/microsoft/MoGe.git

# ---- Additional fbxify Python deps ----
RUN python -m pip install mathutils

# ---- FastAPI + uvicorn for worker API ----
RUN python -m pip install fastapi uvicorn

# ---- flash-attn (keep setuptools<81 for pkg_resources) ----
RUN python -m pip install -U pip wheel packaging ninja psutil "setuptools<81" \
 && mkdir -p /wheelhouse \
 && ( python -m pip wheel --only-binary=:all: --no-deps -w /wheelhouse flash-attn \
      || python -m pip wheel --no-deps --no-build-isolation -w /wheelhouse flash-attn ) \
 && python -m pip install --no-index --find-links=/wheelhouse flash-attn

# ---- xtcocotools ----
RUN python -m pip install --no-build-isolation xtcocotools

# ---- Detectron2 ----
RUN python -m pip install \
      "git+https://github.com/facebookresearch/detectron2.git@a1ce2f9" \
      --no-build-isolation --no-deps

# ---- Headless rendering + paths ----
ENV PYOPENGL_PLATFORM=egl
ENV MOMENTUM_ENABLED=True
ENV MPLBACKEND=Agg
ENV WANDB_MODE=offline
ENV PYTHONPATH=/fbxify

# Entrypoint: with one volume at /fbxify, creates /fbxify/checkpoints and
# /fbxify/cache/{videt_checkpoint,hf_cache,mhr_assets} and symlinks app cache
# paths there (same layout as run.bat), so checkpoints + first-run downloads persist.
COPY fbxify/docker/worker-entrypoint.sh /worker-entrypoint.sh
RUN sed -i 's/\r$//' /worker-entrypoint.sh && chmod +x /worker-entrypoint.sh

EXPOSE 8000
ENV PORT=8000

ENTRYPOINT ["/worker-entrypoint.sh"]
