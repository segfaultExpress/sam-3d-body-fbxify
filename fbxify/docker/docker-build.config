# Docker build/push config - edit these for your registry
# build_docker_ui, build_docker_worker, build_docker_standalone, and build_docker_push read from this file.
# Command-line args override these values.

USERNAME=mordommin94
VERSION=0.1.9

# PULL_FROM_LOCAL=1: copy repo from build context (for testing). PULL_FROM_LOCAL=0: git clone from repo.
PULL_FROM_LOCAL=0
# When PULL_FROM_LOCAL=0, clone the specified branch
BRANCH=main

# RUN_WITH_LOCAL=1: mount local repo over /fbxify at runtime (docker-compose). Use for dev without rebuilding.
RUN_WITH_LOCAL=0
