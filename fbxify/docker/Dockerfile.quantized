# Quantized-backbone R&D image: the worker image + TensorRT + ONNX, running the local checkout.
#
# Used by run_quant_bench.{sh,bat} to benchmark the embedl INT8 encoder
# (https://huggingface.co/embedl/sam-3d-body) against the stock fp32 DINOv3 encoder,
# with and without Fast inference. It can also serve the worker API with
# FBXIFY_QUANTIZED_BACKBONE=trt (see Quantized.md).
#
#   docker build -f fbxify/docker/Dockerfile.quantized -t mordommin94/fbxify-worker:quantized .
#
# TensorRT 10.x (cu12 wheels) matches the cu128 torch in the worker image. embedl notes that
# 10.16+ picks much better INT8 kernels on Ada GPUs, so keep the lower bound.
ARG WORKER_BASE=mordommin94/fbxify-worker:latest
FROM ${WORKER_BASE}

RUN python -m pip install --no-cache-dir "tensorrt-cu12>=10.16,<11" onnx \
 && python -c "import tensorrt as trt; print('TensorRT', trt.__version__)"

WORKDIR /fbxify
COPY . /fbxify
COPY fbxify/docker/standalone-entrypoint.sh /standalone-entrypoint.sh
COPY fbxify/docker/worker-entrypoint.sh /worker-entrypoint.sh
RUN sed -i 's/\r$//' /standalone-entrypoint.sh /worker-entrypoint.sh \
 && chmod +x /standalone-entrypoint.sh /worker-entrypoint.sh

ENV FBXIFY_QUANTIZED_BACKBONE=none
ENV FBXIFY_MODEL=dinov3
EXPOSE 8000
ENV PORT=8000

# Default: same as the worker (uvicorn API). Override the command to run the bench:
#   docker run ... mordommin94/fbxify-worker:quantized python -m fbxify.cli_bench_quantized --backbone trt
ENTRYPOINT ["/standalone-entrypoint.sh"]
CMD ["/worker-entrypoint.sh"]
