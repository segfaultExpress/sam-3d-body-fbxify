{
  "info": {
    "name": "Fbxify Worker API",
    "description": "Test the fbxify worker API (pose, FBX, detection, tracking, mounts, model catalogue). Set `base_url` in collection or environment (e.g. http://localhost:8000). Optional: set `api_key` if FBXIFY_SHARED_SECRET is configured.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "api_key", "value": "" },
    { "key": "job_id", "value": "" },
    { "key": "filename", "value": "pose_outputs_xxxxxxxx.json" },
    { "key": "mount_id", "value": "" }
  ],
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health",
        "description": "Readiness. 200 and ready=true means MHR assets and SAM 3D Body are loaded. 503 means do not submit pose jobs. The `models` object reports the loaded body_model / encoder / detector names. No auth required."
      }
    },
    {
      "name": "Models",
      "description": "Model catalogue (fbxify/models.json plus the user overlay). Pick detectors, encoders and body models by catalogue name; the worker keeps one of each resident and swaps them on demand.",
      "item": [
        {
          "name": "List Models",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{api_key}}", "disabled": true },
              { "key": "X-API-Key", "value": "{{api_key}}", "disabled": true }
            ],
            "url": "{{base_url}}/models",
            "description": "Catalogue entries grouped as detectors / encoders / body_models, each with display_name, type, enabled, default, licence, source kind and status (ready, missing, size-mismatch, ready-unverified, disabled). Also returns `loaded` (what is resident now) and `defaults`. Only names are exposed, never paths. GET /api/models is an alias."
          }
        },
        {
          "name": "Select Models",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{api_key}}", "disabled": true },
              { "key": "X-API-Key", "value": "{{api_key}}", "disabled": true }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "body_model", "value": "vith", "type": "text", "description": "Catalogue name from body_models (e.g. vith, dinov3). Omit to keep the current one." },
                { "key": "encoder", "value": "fp32", "type": "text", "description": "Catalogue name from encoders (e.g. fp32, embedl_int8_trt). Some encoders require a specific body model." },
                { "key": "detector", "value": "vitdet", "type": "text", "description": "Catalogue name from detectors (e.g. vitdet). Omit to keep the current one." }
              ]
            },
            "url": "{{base_url}}/models/select",
            "description": "Swap the resident models now. The previous weights are released and the CUDA cache flushed before loading. Returns the new `loaded` set. 400 for unknown, disabled, not-yet-fetched or incompatible names; 409 while a job holds the GPU; 503 if the worker is not ready."
          }
        },
        {
          "name": "Fetch Models",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{api_key}}", "disabled": true },
              { "key": "X-API-Key", "value": "{{api_key}}", "disabled": true }
            ],
            "url": "{{base_url}}/models/fetch",
            "description": "Re-read the catalogue and download every enabled entry that is still missing (blocking; large checkpoints take minutes). Local-mount entries are only checked, never downloaded. Use after editing the models.json overlay, then List Models to confirm status."
          }
        }
      ]
    },
    {
      "name": "Live",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/live",
        "description": "Process liveness. 200 while the process is up, including when /health is 503. No auth required."
      }
    },
    {
      "name": "Mounts",
      "description": "Persistent file storage. Upload large files once, then reference them by mount_id in job endpoints to skip re-uploading.",
      "item": [
        {
          "name": "Mount File",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    pm.collectionVariables.set('mount_id', data.mount_id);",
                  "    console.log('Saved mount_id: ' + data.mount_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{api_key}}", "disabled": true },
              { "key": "X-API-Key", "value": "{{api_key}}", "disabled": true }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "", "description": "File to mount (e.g. estimation.json, video). Streamed in 8 MB chunks." }
              ]
            },
            "url": "{{base_url}}/mount",
            "description": "Upload a file to persistent mount storage. Returns mount_id which can be passed to job endpoints instead of re-uploading. The mount_id is automatically saved to the collection variable {{mount_id}}."
          }
        },
        {
          "name": "List Mounts",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{api_key}}", "disabled": true },
              { "key": "X-API-Key", "value": "{{api_key}}", "disabled": true }
            ],
            "url": "{{base_url}}/mounts",
            "description": "List all currently mounted files. Returns array of {mount_id, filename, size_bytes, created_at}."
          }
        },
        {
          "name": "Delete Mount",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{api_key}}", "disabled": true },
              { "key": "X-API-Key", "value": "{{api_key}}", "disabled": true }
            ],
            "url": "{{base_url}}/mounts/{{mount_id}}",
            "description": "Remove a single mounted file. Set {{mount_id}} to the mount to delete. Returns 404 if not found."
          }
        }
      ]
    },
    {
      "name": "Create Pose Job",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{api_key}}", "disabled": true },
          { "key": "X-API-Key", "value": "{{api_key}}", "disabled": true }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "input_file", "type": "file", "src": "", "description": "Image or video. Required unless input_mount_id is set." },
            { "key": "input_mount_id", "value": "", "type": "text", "disabled": true, "description": "Mount ID from POST /mount. Use instead of input_file to skip upload." },
            { "key": "bbox_file", "type": "file", "src": "", "description": "Optional CSV bboxes" },
            { "key": "fov_file", "type": "file", "src": "", "description": "Optional FOV file" },
            { "key": "tracking_mode", "value": "count", "type": "text" },
            { "key": "num_people", "value": "1", "type": "text" },
            { "key": "missing_bbox_behavior", "value": "Run Detection", "type": "text" },
            { "key": "fov_method", "value": "Default", "type": "text" },
            { "key": "sample_number", "value": "1", "type": "text" },
            { "key": "precision", "value": "fp32", "type": "text" },
            { "key": "fast_inference", "value": "false", "type": "text", "description": "Skip second body-decoder keypoint-prompt pass (Fast SAM 3D Body). Hands still run." },
            { "key": "body_only", "value": "false", "type": "text", "description": "Body decoder only: no hand crops or hand decoders. Batches with frame_batch_size." },
            { "key": "output_tracking_bbox", "value": "false", "type": "text" },
            { "key": "frame_batch_size", "value": "1", "type": "text" },
            { "key": "detection_batch_size", "value": "1", "type": "text" },
            { "key": "lang", "value": "en", "type": "text" },
            { "key": "body_model", "value": "", "type": "text", "disabled": true, "description": "Optional catalogue name (see Models > List Models). Swaps before the job runs; omit to use what is loaded." },
            { "key": "encoder", "value": "", "type": "text", "disabled": true, "description": "Optional catalogue name (e.g. fp32, embedl_int8_trt)." },
            { "key": "detector", "value": "", "type": "text", "disabled": true, "description": "Optional catalogue name (e.g. vitdet)." }
          ]
        },
        "url": "{{base_url}}/jobs/pose",
        "description": "Submit image/video for pose estimation. Provide either input_file (upload) or input_mount_id (from POST /mount), not both. Returns job_id. Set fast_inference=true to skip the second body-decoder pass. Optional body_model / encoder / detector pick catalogue entries by name (400 if unknown, disabled or incompatible)."
      }
    },
    {
      "name": "Create Pose Job (mounted)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{api_key}}", "disabled": true },
          { "key": "X-API-Key", "value": "{{api_key}}", "disabled": true }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "input_mount_id", "value": "{{mount_id}}", "type": "text", "description": "Mount ID from POST /mount." },
            { "key": "tracking_mode", "value": "count", "type": "text" },
            { "key": "num_people", "value": "1", "type": "text" },
            { "key": "missing_bbox_behavior", "value": "Run Detection", "type": "text" },
            { "key": "fov_method", "value": "Default", "type": "text" },
            { "key": "sample_number", "value": "1", "type": "text" },
            { "key": "precision", "value": "fp32", "type": "text" },
            { "key": "fast_inference", "value": "false", "type": "text", "description": "Skip second body-decoder keypoint-prompt pass (Fast SAM 3D Body). Hands still run." },
            { "key": "body_only", "value": "false", "type": "text", "description": "Body decoder only: no hand crops or hand decoders. Batches with frame_batch_size." },
            { "key": "output_tracking_bbox", "value": "false", "type": "text" },
            { "key": "frame_batch_size", "value": "1", "type": "text" },
            { "key": "detection_batch_size", "value": "1", "type": "text" },
            { "key": "lang", "value": "en", "type": "text" },
            { "key": "body_model", "value": "", "type": "text", "disabled": true, "description": "Optional catalogue name (see Models > List Models)." },
            { "key": "encoder", "value": "", "type": "text", "disabled": true, "description": "Optional catalogue name (e.g. fp32, embedl_int8_trt)." },
            { "key": "detector", "value": "", "type": "text", "disabled": true, "description": "Optional catalogue name (e.g. vitdet)." }
          ]
        },
        "url": "{{base_url}}/jobs/pose",
        "description": "Pose estimation using a previously mounted file. No file upload needed -- uses {{mount_id}} from the Mounts folder. Mount the file first via POST /mount. Set fast_inference=true to skip the second body-decoder pass."
      }
    },
    {
      "name": "Create FBX Job",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{api_key}}", "disabled": true },
          { "key": "X-API-Key", "value": "{{api_key}}", "disabled": true }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "pose_json_file", "type": "file", "src": "", "description": "Pose estimation JSON. Required unless pose_json_mount_id is set." },
            { "key": "pose_json_mount_id", "value": "", "type": "text", "disabled": true, "description": "Mount ID from POST /mount. Use instead of pose_json_file to skip upload." },
            { "key": "profile_name", "value": "mhr", "type": "text" },
            { "key": "use_root_motion", "value": "true", "type": "text" },
            { "key": "auto_floor", "value": "true", "type": "text" },
            { "key": "include_mesh", "value": "false", "type": "text" },
            { "key": "include_extrinsics", "value": "false", "type": "text" },
            { "key": "extrinsics_sample_rate", "value": "0", "type": "text" },
            { "key": "extrinsics_scale", "value": "0.0", "type": "text" },
            { "key": "extrinsics_invert_quaternion", "value": "false", "type": "text" },
            { "key": "extrinsics_invert_translation", "value": "false", "type": "text" },
            { "key": "create_camera", "value": "false", "type": "text" },
            { "key": "camera_zoom", "value": "0.0", "type": "text" },
            { "key": "use_personalized_body", "value": "false", "type": "text" },
            { "key": "lod", "value": "-1", "type": "text" },
            { "key": "outlier_removal_percent", "value": "10.0", "type": "text" },
            { "key": "export_personalized_body_obj", "value": "false", "type": "text" },
            { "key": "graph_refinement", "value": "false", "type": "text" },
            { "key": "lang", "value": "en", "type": "text" },
            { "key": "extrinsics_file", "type": "file", "src": "", "description": "Optional" },
            { "key": "camera_scene", "type": "file", "src": "", "description": "Optional" },
            { "key": "refinement_config", "type": "file", "src": "", "description": "Optional" }
          ]
        },
        "url": "{{base_url}}/jobs/fbx",
        "description": "Convert pose JSON to FBX. Provide either pose_json_file (upload) or pose_json_mount_id (from POST /mount), not both."
      }
    },
    {
      "name": "Create FBX Job (mounted)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{api_key}}", "disabled": true },
          { "key": "X-API-Key", "value": "{{api_key}}", "disabled": true }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "pose_json_mount_id", "value": "{{mount_id}}", "type": "text", "description": "Mount ID from POST /mount." },
            { "key": "profile_name", "value": "mhr", "type": "text" },
            { "key": "use_root_motion", "value": "true", "type": "text" },
            { "key": "auto_floor", "value": "true", "type": "text" },
            { "key": "include_mesh", "value": "false", "type": "text" },
            { "key": "include_extrinsics", "value": "false", "type": "text" },
            { "key": "extrinsics_sample_rate", "value": "0", "type": "text" },
            { "key": "extrinsics_scale", "value": "0.0", "type": "text" },
            { "key": "extrinsics_invert_quaternion", "value": "false", "type": "text" },
            { "key": "extrinsics_invert_translation", "value": "false", "type": "text" },
            { "key": "create_camera", "value": "false", "type": "text" },
            { "key": "camera_zoom", "value": "0.0", "type": "text" },
            { "key": "use_personalized_body", "value": "false", "type": "text" },
            { "key": "lod", "value": "-1", "type": "text" },
            { "key": "outlier_removal_percent", "value": "10.0", "type": "text" },
            { "key": "export_personalized_body_obj", "value": "false", "type": "text" },
            { "key": "graph_refinement", "value": "false", "type": "text" },
            { "key": "lang", "value": "en", "type": "text" },
            { "key": "extrinsics_file", "type": "file", "src": "", "description": "Optional" },
            { "key": "camera_scene", "type": "file", "src": "", "description": "Optional" },
            { "key": "refinement_config", "type": "file", "src": "", "description": "Optional" }
          ]
        },
        "url": "{{base_url}}/jobs/fbx",
        "description": "FBX generation using a previously mounted estimation JSON. No file upload needed -- uses {{mount_id}}. Mount the file first via POST /mount."
      }
    },
    {
      "name": "Create Detection Job",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{api_key}}", "disabled": true },
          { "key": "X-API-Key", "value": "{{api_key}}", "disabled": true }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "input_file", "type": "file", "src": "", "description": "Image or video (required)" },
            { "key": "detection_batch_size", "value": "1", "type": "text" },
            { "key": "detector", "value": "", "type": "text", "disabled": true, "description": "Optional detector catalogue name (e.g. vitdet). Omit to use what is loaded." }
          ]
        },
        "url": "{{base_url}}/jobs/detection",
        "description": "Run human detection only. Returns job_id; output includes bbox CSV. Optional detector picks a catalogue entry by name."
      }
    },
    {
      "name": "Rerun Tracking",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{api_key}}", "disabled": true },
          { "key": "X-API-Key", "value": "{{api_key}}", "disabled": true }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "estimation_file", "type": "file", "src": "", "description": "Pose estimation JSON. Required unless estimation_mount_id is set." },
            { "key": "estimation_mount_id", "value": "", "type": "text", "disabled": true, "description": "Mount ID from POST /mount. Use instead of estimation_file to skip upload." },
            { "key": "tracking_config_file", "type": "file", "src": "", "description": "Optional tracking config JSON file" },
            { "key": "step_through", "value": "false", "type": "text" },
            { "key": "debug_start_frame", "value": "0", "type": "text" }
          ]
        },
        "url": "{{base_url}}/jobs/rerun_tracking",
        "description": "Rerun tracking on existing estimation JSON. Provide either estimation_file (upload) or estimation_mount_id (from POST /mount), not both."
      }
    },
    {
      "name": "Rerun Tracking (mounted)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{api_key}}", "disabled": true },
          { "key": "X-API-Key", "value": "{{api_key}}", "disabled": true }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "estimation_mount_id", "value": "{{mount_id}}", "type": "text", "description": "Mount ID from POST /mount." },
            { "key": "tracking_config_file", "type": "file", "src": "", "description": "Optional tracking config JSON file" },
            { "key": "step_through", "value": "false", "type": "text" },
            { "key": "debug_start_frame", "value": "0", "type": "text" }
          ]
        },
        "url": "{{base_url}}/jobs/rerun_tracking",
        "description": "Rerun tracking using a previously mounted estimation JSON. No file upload needed -- uses {{mount_id}}. Mount the file first via POST /mount. Ideal for iterating on tracking parameters without re-uploading."
      }
    },
    {
      "name": "Get Job Status",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{api_key}}", "disabled": true },
          { "key": "X-API-Key", "value": "{{api_key}}", "disabled": true }
        ],
        "url": "{{base_url}}/jobs/{{job_id}}",
        "description": "Poll status. Use job_id from create pose/fbx/detection/rerun_tracking. Set collection variable job_id after creating a job."
      }
    },
    {
      "name": "Download Job File",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{api_key}}", "disabled": true },
          { "key": "X-API-Key", "value": "{{api_key}}", "disabled": true }
        ],
        "url": "{{base_url}}/jobs/{{job_id}}/files/{{filename}}",
        "description": "Download an output file. Set job_id and filename (e.g. pose_outputs_abc12345.json or output.fbx)."
      }
    },
    {
      "name": "Cancel Jobs",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{api_key}}", "disabled": true },
          { "key": "X-API-Key", "value": "{{api_key}}", "disabled": true }
        ],
        "url": "{{base_url}}/jobs/cancel",
        "description": "Signal worker to cancel current job."
      }
    },
    {
      "name": "Cleanup Temp",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{api_key}}", "disabled": true },
          { "key": "X-API-Key", "value": "{{api_key}}", "disabled": true },
          { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "max_age_hours", "value": "0", "type": "text", "description": "0 = flush all completed/failed jobs; >0 = only older than N hours" },
            { "key": "unmount_all", "value": "false", "type": "text", "description": "Set to true to also remove ALL mounted files. Default false -- mounts are preserved." }
          ]
        },
        "url": "{{base_url}}/cleanup",
        "description": "Remove temp artifacts for completed/failed jobs and orphaned temp dirs. max_age_hours=0 flushes everything; >0 only flushes dirs older than N hours. Running jobs are never touched. Set unmount_all=true to also remove all mounted files (default: false, mounts are preserved)."
      }
    },
    {
      "name": "Storage Info",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{api_key}}", "disabled": true },
          { "key": "X-API-Key", "value": "{{api_key}}", "disabled": true }
        ],
        "url": "{{base_url}}/storage",
        "description": "Report disk usage for /tmp, counts/sizes of fbxify temp artifacts, and mounted file stats (mounts_count, mounts_total_gb, mounts_dir)."
      }
    },
    {
      "name": "Reload Models",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{api_key}}", "disabled": true },
          { "key": "X-API-Key", "value": "{{api_key}}", "disabled": true }
        ],
        "url": "{{base_url}}/reload",
        "description": "Reload models (e.g. after uploading checkpoints via SSH). Releases the resident models, re-reads the catalogue and reinitializes with the default / env selection. Returns 503 if checkpoints still missing. To change which models are loaded without a full reset, use Models > Select Models."
      }
    }
  ]
}
