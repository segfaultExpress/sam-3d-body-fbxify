        "files": [
          { "path": "model.ckpt", "sha256": "b5a2f9d305dd02626b967aa2e86021fba07065df66ce7a7e00ffb9664f150abf", "size": 2109129346 },
          { "path": "model_config.yaml", "sha256": "1012fc3f39cb5e90e3f8fbadf7bded31604bfafdce0321d17a7c1a2d3f08b88d", "size": 1488 },
          { "path": "assets/mhr_model.pt", "sha256": "352e271a6c42729c68554ceaea0c955e866970160c31e35506d782dc0f7377bc", "size": 696110248 }
        ]
      },
      "local_dir": "${CHECKPOINTS_DIR}/sam-3d-body-dinov3",
      "notes": "Required by the embedl INT8 encoders. model.ckpt is 2.1 GB; a 1.7 GB file in this folder is the ViT-H checkpoint by mistake."
    }
  }
}
